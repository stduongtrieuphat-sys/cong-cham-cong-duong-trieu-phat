const express = require('express');
const fs = require('fs');
const path = require('path');
const ExcelJS = require('exceljs');

const app = express();

app.use(express.json());
app.use(express.static(path.join(__dirname, 'public')));

const DB = path.join(__dirname, 'data.json');

// =========================
// CẤU HÌNH CÔNG TY
// =========================

// TỌA ĐỘ CÔNG TY
// Sau này nếu cần chỉnh chính xác hơn thì chỉ sửa 2 số này.
const COMPANY_LAT = 10.9065;
const COMPANY_LON = 106.7685;

// Bán kính cho phép chấm công: 300 mét
const MAX_DISTANCE = 300;

// =========================
// KHỞI TẠO DATABASE
// =========================

if (!fs.existsSync(DB)) {
  fs.writeFileSync(
    DB,
    JSON.stringify({
      users: [
        {
          name: "Lê Hiền",
          password: "1234",
          role: "employee"
        },
        {
          name: "Linh",
          password: "1234",
          role: "employee"
        },
        {
          name: "Admin",
          password: "admin123",
          role: "admin"
        }
      ],
      records: []
    }, null, 2)
  );
}

const read = () => JSON.parse(fs.readFileSync(DB));
const write = x => fs.writeFileSync(DB, JSON.stringify(x, null, 2));

const sessions = new Map();

// =========================
// TÍNH KHOẢNG CÁCH GPS
// =========================

function distanceMeter(lat1, lon1, lat2, lon2) {
  const R = 6371000;

  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLon = (lon2 - lon1) * Math.PI / 180;

  const a =
    Math.sin(dLat / 2) ** 2 +
    Math.cos(lat1 * Math.PI / 180) *
    Math.cos(lat2 * Math.PI / 180) *
    Math.sin(dLon / 2) ** 2;

  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));

  return R * c;
}

// =========================
// XÁC THỰC
// =========================

function auth(req, res, next) {
  const token = req.headers.authorization || '';
  const s = sessions.get(token);

  if (!s) {
    return res.status(401).json({
      error: 'Chưa đăng nhập'
    });
  }

  req.user = s;
  next();
}

function admin(req, res, next) {
  if (req.user.role !== 'admin') {
    return res.status(403).json({
      error: 'Không có quyền'
    });
  }

  next();
}

// =========================
// ĐĂNG NHẬP
// =========================

app.post('/api/login', (req, res) => {

  const db = read();

  const u = db.users.find(
    x =>
      x.name === req.body.name &&
      x.password === req.body.password
  );

  if (!u) {
    return res.status(401).json({
      error: 'Sai tài khoản hoặc mật khẩu'
    });
  }

  const token =
    Math.random().toString(36).slice(2) +
    Date.now();

  sessions.set(token, {
    name: u.name,
    role: u.role
  });

  res.json({
    token,
    name: u.name,
    role: u.role
  });
});

// =========================
// THÔNG TIN NGƯỜI ĐĂNG NHẬP
// =========================

app.get('/api/me', auth, (req, res) => {
  res.json(req.user);
});

// =========================
// CHẤM CÔNG VÀO
// =========================

app.post('/api/checkin', auth, (req, res) => {

  if (req.user.role === 'admin') {
    return res.status(403).json({
      error: 'Admin không chấm công bằng tài khoản quản trị'
    });
  }

  const lat = Number(req.body.lat);
  const lon = Number(req.body.lon);

  if (!Number.isFinite(lat) || !Number.isFinite(lon)) {
    return res.status(400).json({
      error: 'Không lấy được vị trí GPS'
    });
  }

  const distance = distanceMeter(
    COMPANY_LAT,
    COMPANY_LON,
    lat,
    lon
  );

  if (distance > MAX_DISTANCE) {
    return res.status(403).json({
      error:
        `Bạn đang cách công ty khoảng ${Math.round(distance)} mét. ` +
        `Phải ở trong phạm vi ${MAX_DISTANCE} mét mới được chấm công.`
    });
  }

  const db = read();

  const now = new Date();

  const date = now.toLocaleDateString('vi-VN', {
    timeZone: 'Asia/Ho_Chi_Minh'
  });

  const time = now.toLocaleTimeString('vi-VN', {
    timeZone: 'Asia/Ho_Chi_Minh',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit'
  });

  // Tìm bản ghi hôm nay của nhân viên
  let recordsToday = db.records.filter(
    x =>
      x.user === req.user.name &&
      x.date === date
  );

  // Nếu đang có ca chưa checkout thì không cho tạo ca mới
  const openRecord = recordsToday.find(
    x => x.in && !x.out
  );

  if (openRecord) {
    return res.status(409).json({
      error: 'Bạn đang có một ca chưa chấm ra.'
    });
  }

  // Tối đa 2 ca/ngày
  if (recordsToday.length >= 2) {
    return res.status(409).json({
      error: 'Bạn đã chấm đủ 2 ca trong ngày hôm nay.'
    });
  }

  db.records.push({
    user: req.user.name,
    date,
    in: time,
    out: '',
    lat,
    lon,
    distance: Math.round(distance),
    status: 'Đang làm'
  });

  write(db);

  res.json({
    ok: true,
    message: 'Chấm công vào thành công'
  });
});

// =========================
// CHẤM CÔNG RA
// =========================

app.post('/api/checkout', auth, (req, res) => {

  if (req.user.role === 'admin') {
    return res.status(403).json({
      error: 'Không hợp lệ'
    });
  }

  const lat = Number(req.body.lat);
  const lon = Number(req.body.lon);

  if (!Number.isFinite(lat) || !Number.isFinite(lon)) {
    return res.status(400).json({
      error: 'Không lấy được vị trí GPS'
    });
  }

  const distance = distanceMeter(
    COMPANY_LAT,
    COMPANY_LON,
    lat,
    lon
  );

  if (distance > MAX_DISTANCE) {
    return res.status(403).json({
      error:
        `Bạn đang cách công ty khoảng ${Math.round(distance)} mét. ` +
        `Phải ở trong phạm vi ${MAX_DISTANCE} mét mới được chấm công.`
    });
  }

  const db = read();

  const now = new Date();

  const date = now.toLocaleDateString('vi-VN', {
    timeZone: 'Asia/Ho_Chi_Minh'
  });

  const time = now.toLocaleTimeString('vi-VN', {
    timeZone: 'Asia/Ho_Chi_Minh',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit'
  });

  const record = db.records
    .slice()
    .reverse()
    .find(
      x =>
        x.user === req.user.name &&
        x.date === date &&
        x.in &&
        !x.out
    );

  if (!record) {
    return res.status(409).json({
      error: 'Không có ca đang mở để chấm công ra.'
    });
  }

  record.out = time;
  record.status = 'Hoàn tất';
  record.outLat = lat;
  record.outLon = lon;
  record.outDistance = Math.round(distance);

  write(db);

  res.json({
    ok: true,
    message: 'Chấm công ra thành công'
  });
});

// =========================
// XEM LỊCH SỬ CỦA NHÂN VIÊN
// =========================

app.get('/api/my-records', auth, (req, res) => {

  res.json(
    read()
      .records
      .filter(x => x.user === req.user.name)
      .reverse()
  );

});

// =========================
// ADMIN XEM TẤT CẢ
// =========================

app.get('/api/records', auth, admin, (req, res) => {

  res.json(
    read()
      .records
      .slice()
      .reverse()
  );

});

// =========================
// XUẤT EXCEL
// =========================

app.get('/api/export', auth, admin, async (req, res) => {

  const wb = new ExcelJS.Workbook();

  const ws = wb.addWorksheet('Cham cong');

  ws.columns = [
    {
      header: 'Nhân viên',
      key: 'user',
      width: 22
    },
    {
      header: 'Ngày',
      key: 'date',
      width: 14
    },
    {
      header: 'Giờ vào',
      key: 'in',
      width: 14
    },
    {
      header: 'Giờ ra',
      key: 'out',
      width: 14
    },
    {
      header: 'Trạng thái',
      key: 'status',
      width: 18
    },
    {
      header: 'Khoảng cách vào (m)',
      key: 'distance',
      width: 20
    },
    {
      header: 'Khoảng cách ra (m)',
      key: 'outDistance',
      width: 20
    }
  ];

  read().records.forEach(r => {
    ws.addRow({
      user: r.user,
      date: r.date,
      in: r.in,
      out: r.out,
      status: r.status,
      distance: r.distance,
      outDistance: r.outDistance
    });
  });

  res.setHeader(
    'Content-Type',
    'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
  );

  res.setHeader(
    'Content-Disposition',
    'attachment; filename="Cham_cong_Duong_Trieu_Phat.xlsx"'
  );

  await wb.xlsx.write(res);

  res.end();
});

